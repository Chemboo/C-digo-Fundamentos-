# ---------------- 2. BÚSQUEDA ----------------
def buscar():
    dni_buscar = input("\nIngresa el DNI a buscar: ")
    
    try:
        # "r" significa 'read' (leer)
        archivo = open(ARCHIVO, "r", encoding="utf-8")
        lineas = archivo.readlines()
        archivo.close()
    except FileNotFoundError:
        print("Todavía no hay ningún registro en el sistema.")
        return

    encontrado = False
    print("\nResultados:")
    
    for linea in lineas:
        # Quitamos saltos de línea y separamos por las comas
        datos = linea.strip().split(",")
        # datos = [fecha, hora, dni, nombre, edad, motivo]
        
        if datos[2] == dni_buscar:
            print(f"- {datos[0]} {datos[1]} | {datos[3]} | {datos[4]} años | Motivo: {datos[5]}")
            encontrado = True

    if encontrado == False:
        print("No se encontró ninguna atención con ese DNI.")


# ---------------- 3. REPORTES ----------------
def reporte(tipo):
    try:
        archivo = open(ARCHIVO, "r", encoding="utf-8")
        lineas = archivo.readlines()
        archivo.close()
    except FileNotFoundError:
        print("Todavía no hay ningún registro.")
        return

    # Usamos un diccionario simple para contar
    conteo = {}
    total = 0

    for linea in lineas:
        datos = linea.strip().split(",")
        
        # Si el tipo es 'fecha' miramos la posición 0, si es 'motivo' la posición 5
        if tipo == "fecha":
            clave = datos[0]
        else:
            clave = datos[5]

        # Lógica fácil para contar: si ya existe le sumamos 1, sino empezamos en 1
        if clave in conteo:
            conteo[clave] = conteo[clave] + 1
        else:
            conteo[clave] = 1
            
        total = total + 1

    # Imprimimos los resultados
    print(f"\n=== REPORTE POR {tipo.upper()} ===")
    for clave, cantidad in conteo.items():
        print(f"{clave}: {cantidad} atenciones")
    print(f"TOTAL: {total} atenciones")


